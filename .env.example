# Copy to .env and fill in. Never commit .env.
# In dev mode every key may stay empty: mock LLM / mock TTS / dry-run publishing are used.

# --- Mode ---------------------------------------------------------------
# dev  = mocks wherever a key is missing, publishing is always dry-run
# prod = real providers, missing keys are errors
CONTENTBOT_MODE=dev
# Force providers explicitly (optional): mock | anthropic
CONTENTBOT_LLM=
# mock | elevenlabs | none
CONTENTBOT_TTS=
CONTENTBOT_DATA_DIR=./data

# --- AI providers -------------------------------------------------------
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Temporary voice used when a project voice has no provider ID yet
ELEVENLABS_FALLBACK_VOICE_ID=

# --- Project voices (ElevenLabs voice IDs, can be changed any time) -----
VOICE_BATRAKAN=
VOICE_PEDAL=
VOICE_NEUTRAL=
VOICE_ANNA=

# --- Telegram (M2) ------------------------------------------------------
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_IDS=

# --- Storage (M3) -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Platform apps (M3/M4) ----------------------------------------------
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=
TOKEN_ENCRYPTION_KEY=
